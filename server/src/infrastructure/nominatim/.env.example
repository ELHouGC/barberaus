# ==========================================
# Nominatim database
# ==========================================

NOMINATIM_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD


# ==========================================
# Algeria OpenStreetMap dataset (You can change this to any other country or region)
# ==========================================

PBF_URL=https://download.geofabrik.de/africa/algeria-latest.osm.pbf

REPLICATION_URL=https://download.geofabrik.de/africa/algeria-updates/


# ==========================================
# Import configuration (you can choose to change these values, but the defaults are good for most use cases)
# ==========================================

IMPORT_STYLE=address #full will need more than 32GB RAM, address is enough for most use cases 
IMPORT_WIKIPEDIA=false # true will import Wikipedia data, which is not needed for most use cases
THREADS=2


# ==========================================
# API runtime
# ==========================================

GUNICORN_WORKERS=1
WARMUP_ON_STARTUP=false


# ==========================================
# Replication
#none is an initial deployment decision for managing resources while developing ,
#for production you should use catch-up or continuous replication, see https://nominatim.org/release-docs/latest/admin/Replication/
# ==========================================

UPDATE_MODE=none 


# ==========================================
# PostgreSQL resource tuning
# ==========================================

POSTGRES_SHARED_BUFFERS=512MB # for 32 GB RAM, you can set this to 2GB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_AUTOVACUUM_WORK_MEM=128MB
POSTGRES_WORK_MEM=8MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB # for 32 GB RAM, you can set this to 24GB
POSTGRES_MAX_CONNECTIONS=20