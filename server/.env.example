
# Application environment: development | production
ENV=development

# JWT HS256 signing secret (minimum 32 bytes)
# Generate a unique random secret before running the application.
JWT_SECRET=

# Infrastructure
DATABASE_URL=postgres://postgres:postgres@localhost:5432/barberaus
REDIS_URL=redis://127.0.0.1:6379

# Email configuration
# Development: uses ConsoleEmailSender; no verified domain required.
# Production: uses ResendEmailSender; sender domain must be verified with Resend.
# FROM_EMAIL is required in both environments.
FROM_EMAIL="Barberaus <noreply@example.com>"FROM_EMAIL="Barberaus <noreply@example.com>"

# Cloudinary credentials (required in both environments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required only when ENV=production
RESEND_API_KEY=