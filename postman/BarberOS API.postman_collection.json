      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{hostUrl}}/health",
          "host": ["{{hostUrl}}"],
          "path": ["health"]
        }
      },
      "response": []
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "async function injectAccessToken() {",
          "    const urlStr = pm.request.url.toString();",
          "    const publicEndpoints = [",
          "        '/health',",
          "        '/auth/signup',",
          "        '/auth/resend-verification',",
          "        '/auth/verify-email',",
          "        '/auth/login',",
          "        '/auth/session/refresh',",
          "    ];",
          "",
          "    const isPublic = publicEndpoints.some(path => urlStr.includes(path));",
          "",
          "    if (!isPublic) {",
          "        let accessToken = await pm.vault.get('accessToken');",
          "        if (!accessToken) accessToken = pm.environment.get('accessToken');",
          "        if (accessToken) {",
          "            pm.request.headers.upsert({",
          "                key: 'Authorization',",
          "                value: 'Bearer ' + accessToken",
          "            });",
          "        }",
          "    }",
          "}",
          "",
          "await injectAccessToken();"
        ]
      }
    }
  ]
}