{
  "info": {
    "_postman_id": "b303c58e-607b-4087-b218-87baab04d1ea",
    "name": "BarberOS API",
    "description": "Postman collection for BarberOS API test automation. Authentication failures use RFC 9457 problem details; protected client avatar requests use the authenticated user's Cloudinary upload signature.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Sign up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body?.data?.user_id) {",
                  "    pm.environment.set('userId', body.data.user_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"full_name\": \"{{fullName}}\",\n  \"date_of_birth\": \"{{dateOfBirth}}\",\n  \"gender\": \"{{gender}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            }
          },
          "response": []
