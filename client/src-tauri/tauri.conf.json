{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Barberaus",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Barberaus",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' https://tauri.localhost; img-src 'self' data: blob: https://tauri.localhost https://images.unsplash.com https://res.cloudinary.com; media-src 'self' data: blob: https://tauri.localhost; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https://tauri.localhost https://api.cloudinary.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
